{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "saple",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-09-28",
  "workers_dev": true,
  "keep_vars": true,
  "secrets": {
    "required": [
      "JWT_SECRET",
      "AI_API_KEY",
      "SUPABASE_SECRET_KEY",
      "SMTP_PASS"
    ]
  },
  "assets": {
    "directory": "./frontend",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api",
      "/api/*",
      "/robots.txt",
      "/sitemap.xml",
      "/.well-known/security.txt",
      "/security.txt"
    ]
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "07bc21432aeb4508aa304662329faf28"
    }
  ],
  "vars": {
    "SAPLE_RUNTIME": "cloudflare",
    "DB_FALLBACK_ENABLED": "false",
    "DB_PRIMARY_SOURCE": "supabase",
    "JWT_EXPIRES_IN": "1d",
    "FRONTEND_URL": "https://saple.www-raihankabireusc.workers.dev/",
    "PASSWORD_RESET_TOKEN_TTL_MINUTES": "15",
    "AI_ENABLED": "true",
    "AI_API_BASE_URL": "https://api.groq.com/openai/v1",
    "AI_MODEL": "openai/gpt-oss-20b",
    "AI_TIMEOUT_MS": "12000",
    "AI_MAX_OUTPUT_TOKENS": "400",
    "SUPABASE_URL": "https://blljqqgeqeblfngbldxt.supabase.co",
    "SUPABASE_AVATAR_BUCKET": "avatar",
    "SUPABASE_COMPANY_LOGO_BUCKET": "Company_logos",
    "SMTP_HOST": "smtp.gmail.com",
    "SMTP_PORT": "587",
    "SMTP_SECURE": "false",
    "SMTP_USER": "www.raihankabireusc@gmail.com",
    "SMTP_FROM": "Saple <www.raihankabireusc@gmail.com>",
    "SECURITY_CONTACT": "mailto:www.raihankabireusc@gmail.com"
  }
}
