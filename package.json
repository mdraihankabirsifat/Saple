{
  "name": "saple",
  "version": "1.0.0",
  "private": true,
  "description": "Saple Node/Render application and Cloudflare Workers deployment target",
  "scripts": {
    "cf:install": "npm ci --prefix backend",
    "cf:dev": "npm run cf:install && wrangler dev",
    "cf:deploy": "npm run cf:install && wrangler deploy",
    "cf:dry-run": "npm run cf:install && wrangler deploy --dry-run",
    "cf:types": "wrangler types"
  },
  "devDependencies": {
    "wrangler": "^4.20.0"
  }
}
