PORT=3000
DATABASE_URL=postgresql://postgres.project_ref:replace_with_database_password@aws-0-region.pooler.supabase.com:6543/postgres
DB_SSL=true
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace_with_smtp_username
SMTP_PASS=replace_with_smtp_password
SMTP_FROM=Saple <no-reply@example.com>
FRONTEND_URL=http://localhost:5500/
PASSWORD_RESET_TOKEN_TTL_MINUTES=15
DEMO_NORMAL_EMAIL=saple.demo.normal@example.invalid
DEMO_NORMAL_PASSWORD=replace_with_demo_normal_password
DEMO_EMPLOYEE_EMAIL=saple.demo.employee@example.invalid
DEMO_EMPLOYEE_PASSWORD=replace_with_demo_employee_password
DEMO_ADMIN_EMAIL=saple.demo.admin@example.invalid
DEMO_ADMIN_PASSWORD=replace_with_demo_admin_password
