PORT=3000
DATABASE_URL=postgresql://postgres.project_ref:replace_with_database_password@aws-0-region.pooler.supabase.com:5432/postgres
DB_SSL=true
DB_POOL_MAX=5
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000
# Ports 5500 and 5501 on localhost/127.0.0.1 are always allowed for local static servers.
# Add only exact extra origins here, comma-separated. Leave empty for same-origin hosting.
CORS_ORIGINS=
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace_with_smtp_username
SMTP_PASS=replace_with_smtp_password
SMTP_FROM=Saple <no-reply@example.com>
FRONTEND_URL=http://localhost:3000/
PASSWORD_RESET_TOKEN_TTL_MINUTES=15
# Optional public security contact for /.well-known/security.txt (mailto: or https:).
SECURITY_CONTACT=
# Optional Saple Guide AI provider. See docs/ai-assistant-setup.md.
AI_ENABLED=false
AI_API_KEY=replace_with_ai_provider_key
AI_API_BASE_URL=https://api.provider.example/openai/v1
AI_MODEL=replace_with_a_current_model_name
AI_TIMEOUT_MS=12000
AI_MAX_OUTPUT_TOKENS=400
DEMO_NORMAL_EMAIL=saple.demo.normal@example.invalid
DEMO_NORMAL_PASSWORD=replace_with_demo_normal_password
DEMO_EMPLOYEE_EMAIL=saple.demo.employee@example.invalid
DEMO_EMPLOYEE_PASSWORD=replace_with_demo_employee_password
DEMO_ADMIN_EMAIL=saple.demo.admin@example.invalid
DEMO_ADMIN_PASSWORD=replace_with_demo_admin_password
