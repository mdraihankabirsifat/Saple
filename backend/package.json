{
  "name": "saple-backend",
  "version": "1.0.0",
  "description": "Express and Supabase PostgreSQL API for the Saple database project",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test",
    "test:integration": "node tests/integration.workflow.js",
    "provision:demo-users": "node scripts/provisionDemoUsers.js",
    "verify:database": "node scripts/verifyDatabase.js",
    "local:up": "node scripts/localApp.js up",
    "local:down": "node scripts/localApp.js down",
    "local:db-up": "node scripts/localApp.js db-up",
    "local:db-down": "node scripts/localApp.js db-down",
    "local:status": "node scripts/localApp.js ps",
    "local:logs": "node scripts/localApp.js logs",
    "local:accounts": "node scripts/localApp.js accounts",
    "local:test": "node scripts/localApp.js test",
    "diagnose:smtp": "node scripts/smtpDiagnostic.js",
    "test:integration:jobs": "node tests/integration.jobs-representatives.js"
  },
  "private": true,
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.13",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "nodemon": "^3.1.10",
    "sharp": "^0.34.5",
    "yaml": "^2.9.0"
  }
}
